{
  "name": "@starria/campaign-core",
  "version": "0.1.0",
  "description": "Reusable advertising campaign infrastructure for STARRIA",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.4.0"
  },
  "keywords": ["starria", "campaigns", "advertising", "promotion"],
  "license": "UNLICENSED",
  "private": true
}
