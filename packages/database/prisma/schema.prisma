  providerName   String?
  numberType     String?
  level          NumberCompatibilityLevel @default(UNKNOWN)
  successRateBps Int?
  sampleSize     Int                      @default(0)
  lastTestedAt   DateTime?
  evidence       String?
  blocked        Boolean                  @default(false)
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt

  @@unique([serviceKey, countryCode, providerName, numberType])
}

model VirtualNumberPurchaseLimit {
  id          String    @id @default(uuid())
  workspaceId String
  userId      String?
  periodType  String    @default("MONTH") // MONTH, WEEK, DAY, ROLLING_30D
  limitMinor  Int // in minor units of the workspace currency
  spentMinor  Int       @default(0)
  periodStart DateTime
  periodEnd   DateTime
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  workspace   Workspace @relation(fields: [workspaceId], references: [id])

  @@index([workspaceId, userId, periodStart, periodEnd])
}

model VirtualNumberReconciliation {
  id                   String    @id @default(uuid())
  providerName         String
  domain               String    @default("VIRTUAL_NUMBER")
  reportPeriodStart    DateTime
  reportPeriodEnd      DateTime
  providerBalanceMinor Int? // Latest known balance from provider
  providerCurrency     String    @default("USD")
  declaredCostMinor    Int       @default(0) // Sum of supplierCostMinor from orders in period
  discrepancyMinor     Int? // providerBalance - declaredCost (can be negative)
  discrepancyBps       Int? // Percentage of discrepancy
  status               String    @default("PENDING") // PENDING, RESOLVED, INVESTIGATION
  notes                String?
  reviewedBy           String?
  reviewedAt           DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([providerName, reportPeriodStart, reportPeriodEnd])
  @@index([status, createdAt])
}

model VirtualNumberMarginAnalytics {
  id                  String   @id @default(uuid())
  orderId             String
  countryCode         String
  providerName        String
  costMinorUsd        Int
  costMinorNgn        Int
  sellMinorNgn        Int
  marginMinorNgn      Int      @default(0)
  marginBps           Int      @default(0)
  expectedMarginBps   Int      @default(3500) // 35% default markup
  marginVarianceBps   Int      @default(0) // Actual - Expected
  fxRateMicrosApplied BigInt?
  createdAt           DateTime @default(now())

  @@index([countryCode, providerName, createdAt])
  @@index([marginVarianceBps, createdAt])
}

model DigitalAccessCategory {
  id          String                 @id @default(uuid())
  name        String
  slug        String                 @unique
  description String?
  sortOrder   Int                    @default(100) @map("sort_order")
  isActive    Boolean                @default(true) @map("is_active")
  createdAt   DateTime               @default(now()) @map("created_at")
  updatedAt   DateTime               @updatedAt @map("updated_at")
  deletedAt   DateTime?              @map("deleted_at")
  services    DigitalAccessService[]

  @@index([isActive, sortOrder])
  @@index([deletedAt])
  @@map("digital_access_categories")
}

model DigitalAccessService {
  id                 String                 @id @default(uuid())
  name               String
  category           String
  slug               String                 @unique
  description        String
  startingPriceMinor Int                    @default(0) @map("starting_price")
  currency           String                 @default("NGN")
  deliveryEta        String                 @map("delivery_eta")
  isActive           Boolean                @default(false) @map("is_active")
  isFeatured         Boolean                @default(false) @map("is_featured")
  thumbnail          String?
  createdAt          DateTime               @default(now()) @map("created_at")
  updatedAt          DateTime               @updatedAt @map("updated_at")
  deletedAt          DateTime?              @map("deleted_at")
  categoryRecord     DigitalAccessCategory  @relation(fields: [category], references: [slug])
  plans              DigitalAccessPlan[]
  requests           DigitalAccessRequest[]

  @@index([category, isActive])
  @@index([isFeatured, isActive])
  @@index([deletedAt])
  @@map("digital_access_services")
}

model DigitalAccessPlan {
  id          String                 @id @default(uuid())
  serviceId   String                 @map("service_id")
  planName    String                 @map("plan_name")
  duration    String
  priceMinor  Int                    @default(0) @map("price")
  currency    String                 @default("NGN")
  description String
  isActive    Boolean                @default(false) @map("is_active")
  createdAt   DateTime               @default(now()) @map("created_at")
  updatedAt   DateTime               @updatedAt @map("updated_at")
  deletedAt   DateTime?              @map("deleted_at")
  service     DigitalAccessService   @relation(fields: [serviceId], references: [id])
  requests    DigitalAccessRequest[]

  @@index([serviceId, isActive])
  @@index([deletedAt])
  @@map("digital_access_plans")
}

model DigitalAccessRequest {
  id             String                      @id @default(uuid())
  workspaceId    String                      @map("workspace_id")
  userId         String?                     @map("user_id")
  serviceId      String                      @map("service_id")
  planId         String                      @map("plan_id")
  contactType    String                      @map("contact_type")
  contactValue   String                      @map("contact_value")
  notes          String?
  status         DigitalAccessRequestStatus  @default(PENDING)
  assignedTo     String?                     @map("assigned_to")
  amountMinor    Int                         @map("amount_minor")
  currency       String                      @default("NGN")
  idempotencyKey String                      @unique @map("idempotency_key")
  metadata       Json                        @default("{}")
  createdAt      DateTime                    @default(now()) @map("created_at")
  updatedAt      DateTime                    @updatedAt @map("updated_at")
  deletedAt      DateTime?                   @map("deleted_at")
  workspace      Workspace                   @relation(fields: [workspaceId], references: [id])
  user           User?                       @relation(fields: [userId], references: [id])
  service        DigitalAccessService        @relation(fields: [serviceId], references: [id])
  plan           DigitalAccessPlan           @relation(fields: [planId], references: [id])
  walletCharges  DigitalAccessWalletCharge[]

  @@index([workspaceId, status, createdAt])
  @@index([userId, createdAt])
  @@index([serviceId, status])
  @@index([planId])
  @@index([deletedAt])
  @@map("digital_access_requests")
}

model DigitalAccessWalletCharge {
  id                  String                          @id @default(uuid())
  workspaceId         String                          @map("workspace_id")
  walletId            String                          @map("wallet_id")
  requestId           String                          @map("request_id")
  idempotencyKey      String                          @unique @map("idempotency_key")
  amountMinor         Int                             @map("amount_minor")
  currency            String                          @default("NGN")
  status              DigitalAccessWalletChargeStatus @default(CHARGED)
  debitLedgerEntryId  String?                         @map("debit_ledger_entry_id")
  refundLedgerEntryId String?                         @map("refund_ledger_entry_id")
  metadata            Json                            @default("{}")
  createdAt           DateTime                        @default(now()) @map("created_at")
  updatedAt           DateTime                        @updatedAt @map("updated_at")
  workspace           Workspace                       @relation(fields: [workspaceId], references: [id])
  wallet              Wallet                          @relation(fields: [walletId], references: [id])
  request             DigitalAccessRequest            @relation(fields: [requestId], references: [id])

  @@unique([workspaceId, requestId])
  @@index([workspaceId, status, createdAt])
  @@index([walletId, createdAt])
  @@map("digital_access_wallet_charges")
}

model AnalyticsMetric {
  id          String    @id @default(uuid())
  workspaceId String
  campaignId  String?
  name        String
  value       Float
  dimensions  Json      @default("{}")
  recordedAt  DateTime  @default(now())
  campaign    Campaign? @relation(fields: [campaignId], references: [id])

  @@index([workspaceId, name, recordedAt])
  @@index([campaignId, recordedAt])
}

model Notification {
  id                String                        @id @default(uuid())
  workspaceId       String
  recipientUserId   String?
  eventId           String?
  channel           String
  category          String                        @default("campaign")
  priority          String                        @default("normal")
  status            NotificationStatus            @default(QUEUED)
  title             String
  body              String
  actionUrl         String?
  entityType        String?
  entityId          String?
  idempotencyKey    String?                       @unique
  provider          String?
  providerMessageId String?
  deliveredAt       DateTime?
  failedAt          DateTime?
  errorCode         String?
  metadata          Json                          @default("{}")
  readAt            DateTime?
  createdAt         DateTime                      @default(now())
  updatedAt         DateTime                      @updatedAt
  workspace         Workspace                     @relation(fields: [workspaceId], references: [id])
  recipient         User?                         @relation("NotificationRecipient", fields: [recipientUserId], references: [id])
  deliveryAttempts  NotificationDeliveryAttempt[]

  @@index([workspaceId, readAt])
  @@index([workspaceId, status, createdAt])
  @@index([recipientUserId, readAt, createdAt])
  @@index([entityType, entityId])
}

model NotificationDeliveryAttempt {
  id                String       @id @default(uuid())
  notificationId    String
  channel           String
  provider          String
  status            String
  providerMessageId String?
  response          Json         @default("{}")
  errorCode         String?
  errorMessage      String?
  attemptedAt       DateTime     @default(now())
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  notification      Notification @relation(fields: [notificationId], references: [id])

  @@index([notificationId, attemptedAt])
  @@index([channel, provider, attemptedAt])
}

model NotificationPreference {
  id          String    @id @default(uuid())
  workspaceId String
  userId      String
  eventName   String
  inApp       Boolean   @default(true)
  email       Boolean   @default(true)
  whatsapp    Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  workspace   Workspace @relation(fields: [workspaceId], references: [id])
  user        User      @relation(fields: [userId], references: [id])

  @@unique([workspaceId, userId, eventName])
  @@index([userId, eventName])
}

model SupportTicket {
  id              String    @id @default(uuid())
  workspaceId     String
  requesterUserId String
  subject         String
  status          String    @default("OPEN")
  priority        String    @default("NORMAL")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  workspace       Workspace @relation(fields: [workspaceId], references: [id])

  @@index([workspaceId, status, priority])
}

model ReferralAccount {
  id                String    @id @default(uuid())
  workspaceId       String
  code              String    @unique
  commissionRateBps Int       @default(500)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  workspace         Workspace @relation(fields: [workspaceId], references: [id])

  @@index([workspaceId])
}

model AuditLog {
  id          String     @id @default(uuid())
  workspaceId String?
  actorUserId String?
  action      String
  entityType  String
  entityId    String
  metadata    Json       @default("{}")
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  workspace   Workspace? @relation(fields: [workspaceId], references: [id])
  actor       User?      @relation("AuditActor", fields: [actorUserId], references: [id])

  @@index([workspaceId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([entityType, entityId])
}

enum PersonaType {
  SYNTHETIC
  VERIFIED
  CAST
}

enum PersonaStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

model Persona {
  id              String        @id @default(uuid())
  workspaceId     String
  createdByUserId String
  name            String
  role            String
  type            PersonaType
  status          PersonaStatus @default(DRAFT)
  description     String?
  hasVoice        Boolean       @default(false)
  hasMotion       Boolean       @default(false)
  consentedAt     DateTime?
  metadata        Json          @default("{}")
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  deletedAt       DateTime?
  workspace       Workspace     @relation(fields: [workspaceId], references: [id])
  createdBy       User          @relation("PersonaCreator", fields: [createdByUserId], references: [id])
  campaigns       Campaign[]

  @@index([workspaceId, status])
  @@index([deletedAt])
}

enum AutomationTriggerKind {
  BUDGET_THRESHOLD
  PERFORMANCE_THRESHOLD
  SCHEDULE
  WALLET_BALANCE
  CREATIVE_AGE
}

enum AutomationWorkflowStatus {
  ACTIVE
  PAUSED
  DRAFT
}

model AutomationWorkflow {
  id              String                   @id @default(uuid())
  workspaceId     String
  createdByUserId String
  name            String
  triggerKind     AutomationTriggerKind
  triggerSummary  String
  actionSummary   String
  status          AutomationWorkflowStatus @default(DRAFT)
  config          Json                     @default("{}")
  runCount        Int                      @default(0)
  lastRunAt       DateTime?
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt
  deletedAt       DateTime?
  workspace       Workspace                @relation(fields: [workspaceId], references: [id])
  createdBy       User                     @relation("AutomationWorkflowCreator", fields: [createdByUserId], references: [id])

  @@index([workspaceId, status])
  @@index([deletedAt])
}

model MarketplaceAgency {
  id            String    @id @default(uuid())
  name          String
  specialty     String
  location      String
  verified      Boolean   @default(false)
  ratingBps     Int       @default(0)
  reviewCount   Int       @default(0)
  campaignCount Int       @default(0)
  teamSize      Int       @default(0)
  description   String
  packages      String[]  @default([])
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  @@index([isActive, specialty])
  @@index([deletedAt])
}

model MarketplaceCreator {
  id            String    @id @default(uuid())
  name          String
  niche         String
  verified      Boolean   @default(false)
  followerCount Int       @default(0)
  engagementBps Int       @default(0)
  rateMinor     Int       @default(0)
  currency      String    @default("NGN")
  languages     String[]  @default([])
  platforms     String[]  @default([])
  pastCampaigns Int       @default(0)
  bio           String
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  @@index([isActive, niche])
  @@index([deletedAt])
}

// ─── Two-factor authentication ─────────────────────────────────────────────

model TwoFactorBackupCode {
  id        String    @id @default(uuid())
  userId    String
  codeHash  String
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id])

  @@index([userId, usedAt])
}

// ─── Developer API keys ─────────────────────────────────────────────────────

enum ApiKeyEnvironment {
  TEST
  PRODUCTION
}

model ApiKey {
  id              String            @id @default(uuid())
  workspaceId     String
  createdByUserId String
  name            String
  environment     ApiKeyEnvironment @default(TEST)
  keyPrefix       String
  keyHash         String            @unique
  scopes          String[]          @default([])
  lastUsedAt      DateTime?
  revokedAt       DateTime?
  createdAt       DateTime          @default(now())
  workspace       Workspace         @relation(fields: [workspaceId], references: [id])
  createdBy       User              @relation("ApiKeyCreator", fields: [createdByUserId], references: [id])

  @@index([workspaceId, revokedAt])
}

// ─── Outgoing webhooks ───────────────────────────────────────────────────────

model OutgoingWebhookSubscription {
  id              String                    @id @default(uuid())
  workspaceId     String
  createdByUserId String
  targetUrl       String
  events          String[]                  @default([])
  signingSecret   String
  isActive        Boolean                   @default(true)
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt
  workspace       Workspace                 @relation(fields: [workspaceId], references: [id])
  createdBy       User                      @relation("OutgoingWebhookSubscriptionCreator", fields: [createdByUserId], references: [id])
  deliveries      OutgoingWebhookDelivery[]

  @@index([workspaceId, isActive])
}

model OutgoingWebhookDelivery {
  id             String                      @id @default(uuid())
  subscriptionId String
  eventName      String
  payload        Json                        @default("{}")
  status         String                      @default("PENDING")
  attempts       Int                         @default(0)
  responseStatus Int?
  lastAttemptAt  DateTime?
  createdAt      DateTime                    @default(now())
  subscription   OutgoingWebhookSubscription @relation(fields: [subscriptionId], references: [id])

  @@index([subscriptionId, createdAt])
  @@index([eventName, status])
}

// ─── Marketplace listing applications ──────────────────────────────────────

enum MarketplaceApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

model MarketplaceAgencyApplication {
