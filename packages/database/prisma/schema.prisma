  workspaceId        String
  applicantUserId    String
  status             MarketplaceApplicationStatus @default(PENDING)
  name               String
  specialty          String
  location           String
  description        String
  packages           String[]                     @default([])
  reviewedByUserId   String?
  reviewedAt         DateTime?
  rejectionReason    String?
  resultingListingId String?
  createdAt          DateTime                     @default(now())
  updatedAt          DateTime                     @updatedAt
  workspace          Workspace                    @relation(fields: [workspaceId], references: [id])
  applicant          User                         @relation("MarketplaceAgencyApplicant", fields: [applicantUserId], references: [id])
  reviewer           User?                        @relation("MarketplaceAgencyReviewer", fields: [reviewedByUserId], references: [id])

  @@index([workspaceId, status])
  @@index([status, createdAt])
}

model MarketplaceCreatorApplication {
  id                 String                       @id @default(uuid())
  workspaceId        String
  applicantUserId    String
  status             MarketplaceApplicationStatus @default(PENDING)
  name               String
  niche              String
  bio                String
  followerCount      Int                          @default(0)
  languages          String[]                     @default([])
  platforms          String[]                     @default([])
  rateMinor          Int                          @default(0)
  reviewedByUserId   String?
  reviewedAt         DateTime?
  rejectionReason    String?
  resultingListingId String?
  createdAt          DateTime                     @default(now())
  updatedAt          DateTime                     @updatedAt
  workspace          Workspace                    @relation(fields: [workspaceId], references: [id])
  applicant          User                         @relation("MarketplaceCreatorApplicant", fields: [applicantUserId], references: [id])
  reviewer           User?                        @relation("MarketplaceCreatorReviewer", fields: [reviewedByUserId], references: [id])

  @@index([workspaceId, status])
  @@index([status, createdAt])
}

// ─── Reward Engine ──────────────────────────────────────────────────────────────

model RewardCampaign {
  id               String                   @id @default(uuid())
  workspaceId      String
  name             String
  description      String?
  status           RewardCampaignStatus     @default(DRAFT)
  totalSlots       Int
  claimedSlots     Int                      @default(0)
  rewardProductId  String
  rewardValueMinor Int
  currency         String                   @default("NGN")
  eligibilityRules Json                     @default("{}")
  startsAt         DateTime
  endsAt           DateTime?
  metadata         Json                     @default("{}")
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt
  workspace        Workspace                @relation(fields: [workspaceId], references: [id])
  rewardProduct    VoucherProduct           @relation(fields: [rewardProductId], references: [id])
  tasks            RewardTask[]
  participants     RewardParticipant[]
  entitlements     RewardEntitlement[]
  qrCodes          RewardQrCode[]
  leaderboard      RewardLeaderboardEntry[]

  @@index([workspaceId, status])
  @@index([status, startsAt, endsAt])
}

model RewardTask {
  id                 String           @id @default(uuid())
  campaignId         String
  taskType           RewardTaskType
  label              String
  description        String?
  verificationConfig Json             @default("{}")
  sortOrder          Int              @default(0)
  required           Boolean          @default(true)
  metadata           Json             @default("{}")
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  campaign           RewardCampaign   @relation(fields: [campaignId], references: [id])
  completions        TaskCompletion[]
  qrCodes            RewardQrCode[]

  @@index([campaignId, sortOrder])
}

model RewardParticipant {
  id           String              @id @default(uuid())
  campaignId   String
  userId       String
  joinedAt     DateTime            @default(now())
  completedAt  DateTime?
  metadata     Json                @default("{}")
  campaign     RewardCampaign      @relation(fields: [campaignId], references: [id])
  user         User                @relation("RewardParticipant", fields: [userId], references: [id])
  completions  TaskCompletion[]
  entitlements RewardEntitlement[]

  @@unique([campaignId, userId])
  @@index([userId, joinedAt])
}

model TaskCompletion {
  id                 String               @id @default(uuid())
  taskId             String
  participantId      String
  status             TaskCompletionStatus @default(PENDING_VERIFICATION)
  proofPayload       Json                 @default("{}")
  verifiedAt         DateTime?
  verifiedBy         String?
  rejectionReason    String?
  idempotencyKey     String               @unique
  metadata           Json                 @default("{}")
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  task               RewardTask           @relation(fields: [taskId], references: [id])
  participant        RewardParticipant    @relation(fields: [participantId], references: [id])
  verificationEvents VerificationEvent[]

  @@unique([taskId, participantId])
  @@index([participantId, status])
  @@index([status, createdAt])
}

model RewardEntitlement {
  id               String                  @id @default(uuid())
  campaignId       String
  participantId    String
  status           RewardEntitlementStatus @default(RESERVED)
  rewardProductId  String
  rewardValueMinor Int
  currency         String                  @default("NGN")
  idempotencyKey   String                  @unique
  reservedAt       DateTime                @default(now())
  fulfilledAt      DateTime?
  metadata         Json                    @default("{}")
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt
  campaign         RewardCampaign          @relation(fields: [campaignId], references: [id])
  participant      RewardParticipant       @relation(fields: [participantId], references: [id])
  rewardProduct    VoucherProduct          @relation(fields: [rewardProductId], references: [id])
  fulfillment      RewardFulfillment?

  @@unique([campaignId, participantId])
  @@index([status, campaignId])
}

model RewardFulfillment {
  id             String                  @id @default(uuid())
  entitlementId  String                  @unique
  handler        VoucherProductHandler
  ledgerEntryId  String?
  vtuOrderId     String?
  providerRef    String?
  status         RewardFulfillmentStatus @default(PENDING)
  failureReason  String?
  idempotencyKey String                  @unique
  metadata       Json                    @default("{}")
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt
  entitlement    RewardEntitlement       @relation(fields: [entitlementId], references: [id])

  @@index([status, createdAt])
}

model VerificationEvent {
  id           String             @id @default(uuid())
  completionId String
  method       VerificationMethod
  success      Boolean
  providerRef  String?
  payload      Json               @default("{}")
  createdAt    DateTime           @default(now())
  completion   TaskCompletion     @relation(fields: [completionId], references: [id])

  @@index([completionId, createdAt])
}

model RewardQrCode {
  id         String         @id @default(uuid())
  campaignId String
  taskId     String
  token      String         @unique
  maxScans   Int            @default(1)
  scanCount  Int            @default(0)
  expiresAt  DateTime
  metadata   Json           @default("{}")
  createdAt  DateTime       @default(now())
  campaign   RewardCampaign @relation(fields: [campaignId], references: [id])
  task       RewardTask     @relation(fields: [taskId], references: [id])

  @@index([campaignId, taskId])
}

model RewardLeaderboardEntry {
  id             String         @id @default(uuid())
  campaignId     String
  userId         String
  displayName    String
  tasksCompleted Int            @default(0)
  rank           Int
  updatedAt      DateTime       @updatedAt
  campaign       RewardCampaign @relation(fields: [campaignId], references: [id])

  @@unique([campaignId, userId])
  @@index([campaignId, rank])
}
