  AUTOMATIC
  MANUAL_REVIEW
  WEBHOOK
}

enum RewardFulfillmentStatus {
  PENDING
  SUCCESS
  FAILED
  AMBIGUOUS
}

model User {
  id                             String                          @id @default(uuid())
  email                          String?                         @unique
  username                       String                          @unique
  name                           String
  displayName                    String?
  defaultWorkspaceId             String?
  status                         UserStatus                      @default(ACTIVE)
  passwordHash                   String?
  emailVerifiedAt                DateTime?
  totpSecretEncrypted            String?
  totpEnabledAt                  DateTime?
  createdAt                      DateTime                        @default(now())
  updatedAt                      DateTime                        @updatedAt
  deletedAt                      DateTime?
  defaultWorkspace               Workspace?                      @relation("UserDefaultWorkspace", fields: [defaultWorkspaceId], references: [id])
  memberships                    TeamMember[]
  sessions                       Session[]
  auditLogs                      AuditLog[]                      @relation("AuditActor")
  digitalAccessRequests          DigitalAccessRequest[]
  companyProfiles                CompanyProfile[]                @relation("CompanyProfileOwner")
  mediaAssets                    MediaAsset[]                    @relation("MediaAssetUploader")
  voucherPurchases               Voucher[]                       @relation("VoucherPurchaser")
  voucherOwnerships              Voucher[]                       @relation("VoucherOwner")
  voucherClaims                  VoucherClaimToken[]             @relation("VoucherClaimedBy")
  campaignNotes                  CampaignNote[]                  @relation("CampaignNoteAuthor")
  campaignAssignments            CampaignAssignment[]            @relation("CampaignAssignee")
  assignedCampaigns              CampaignAssignment[]            @relation("CampaignAssigner")
  campaignReports                CampaignReport[]                @relation("CampaignReportGenerator")
  campaignLedgerEntries          CampaignLedgerEntry[]           @relation("CampaignLedgerEntryActor")
  notifications                  Notification[]                  @relation("NotificationRecipient")
  notificationPrefs              NotificationPreference[]
  createdPersonas                Persona[]                       @relation("PersonaCreator")
  createdWorkflows               AutomationWorkflow[]            @relation("AutomationWorkflowCreator")
  twoFactorBackupCodes           TwoFactorBackupCode[]
  apiKeys                        ApiKey[]                        @relation("ApiKeyCreator")
  outgoingWebhookSubs            OutgoingWebhookSubscription[]   @relation("OutgoingWebhookSubscriptionCreator")
  marketplaceAgencyApplications  MarketplaceAgencyApplication[]  @relation("MarketplaceAgencyApplicant")
  marketplaceCreatorApplications MarketplaceCreatorApplication[] @relation("MarketplaceCreatorApplicant")
  reviewedAgencyApplications     MarketplaceAgencyApplication[]  @relation("MarketplaceAgencyReviewer")
  reviewedCreatorApplications    MarketplaceCreatorApplication[] @relation("MarketplaceCreatorReviewer")
  invitedTeamMembers             TeamMember[]                    @relation("TeamMemberInviter")
  rewardParticipations           RewardParticipant[]             @relation("RewardParticipant")

  @@index([status])
  @@index([deletedAt])
}

model Organization {
  id          String       @id @default(uuid())
  name        String
  slug        String       @unique
  ownerUserId String
  region      String       @default("global")
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  deletedAt   DateTime?
  workspaces  Workspace[]
  members     TeamMember[]

  @@index([ownerUserId])
  @@index([deletedAt])
}

model Workspace {
  id                             String                          @id @default(uuid())
  organizationId                 String
  name                           String
  defaultCurrency                String                          @default("NGN")
  createdAt                      DateTime                        @default(now())
  updatedAt                      DateTime                        @updatedAt
  deletedAt                      DateTime?
  organization                   Organization                    @relation(fields: [organizationId], references: [id])
  defaultForUsers                User[]                          @relation("UserDefaultWorkspace")
  campaigns                      Campaign[]
  wallets                        Wallet[]
  paymentIntents                 PaymentIntent[]
  smmOrders                      SmmOrder[]
  growthOrders                   GrowthOrder[]
  vtuOrders                      VtuOrder[]
  vtuWalletCharges               VtuWalletCharge[]
  virtualNumbers                 VirtualNumber[]
  virtualNumberOrders            VirtualNumberOrder[]
  virtualNumberWalletCharges     VirtualNumberWalletCharge[]
  virtualNumberPurchaseLimits    VirtualNumberPurchaseLimit[]
  digitalAccessRequests          DigitalAccessRequest[]
  digitalAccessWalletCharges     DigitalAccessWalletCharge[]
  companyProfiles                CompanyProfile[]
  mediaAssets                    MediaAsset[]
  vouchers                       Voucher[]
  campaignInvoices               CampaignInvoice[]
  campaignLedgerEntries          CampaignLedgerEntry[]
  eventOutbox                    EventOutbox[]
  notifications                  Notification[]
  notificationPrefs              NotificationPreference[]
  supportTickets                 SupportTicket[]
  referralAccounts               ReferralAccount[]
  auditLogs                      AuditLog[]
  adAccounts                     AdAccount[]
  personas                       Persona[]
  automationWorkflows            AutomationWorkflow[]
  apiKeys                        ApiKey[]
  outgoingWebhookSubscriptions   OutgoingWebhookSubscription[]
  marketplaceAgencyApplications  MarketplaceAgencyApplication[]
  marketplaceCreatorApplications MarketplaceCreatorApplication[]
  rewardCampaigns                RewardCampaign[]

  @@index([organizationId])
  @@index([deletedAt])
}

model TeamMember {
  id              String           @id @default(uuid())
  userId          String
  organizationId  String
  role            OrganizationRole
  permissions     String[]         @default([])
  invitedByUserId String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  deletedAt       DateTime?
  user            User             @relation(fields: [userId], references: [id])
  organization    Organization     @relation(fields: [organizationId], references: [id])
  invitedBy       User?            @relation("TeamMemberInviter", fields: [invitedByUserId], references: [id])

  @@unique([userId, organizationId])
  @@index([organizationId, role])
}

model Session {
  id         String    @id @default(uuid())
  userId     String
  tokenHash  String    @unique
  deviceName String?
  ipAddress  String?
  userAgent  String?
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  user       User      @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([expiresAt])
}

model Campaign {
  id                 String                  @id @default(uuid())
  workspaceId        String
  creatorUserId      String
  name               String
  objective          CampaignObjective
  status             CampaignStatus          @default(DRAFT)
  budgetMinor        Int
  dailySpendCapMinor Int?
  currency           String                  @default("NGN")
  provider           String                  @default("MOCK")
  providerReference  String?
  companyProfileId   String?
  personaId          String?
  adAccountId        String?
  riskAction         CampaignRiskAction?
  riskScore          Int?
  brief              String?
  targetAudience     Json                    @default("{}")
  placementPlan      Json                    @default("{}")
  submittedAt        DateTime?
  approvedAt         DateTime?
  approvedByUserId   String?
  cancelledAt        DateTime?
  metadata           Json                    @default("{}")
  startsAt           DateTime
  endsAt             DateTime?
  timezone           String                  @default("UTC")
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt
  deletedAt          DateTime?
  workspace          Workspace               @relation(fields: [workspaceId], references: [id])
  companyProfile     CompanyProfile?         @relation(fields: [companyProfileId], references: [id])
  persona            Persona?                @relation(fields: [personaId], references: [id])
  destination        Destination?
  livePromotion      LivePromotion?
  analytics          AnalyticsMetric[]
  creatives          CampaignCreative[]
  notes              CampaignNote[]
  statusHistory      CampaignStatusHistory[]
  assignments        CampaignAssignment[]
  manualPlacements   ManualAdPlacement[]
  reports            CampaignReport[]
  budgetHolds        CampaignBudgetHold[]
  invoices           CampaignInvoice[]
  spendEntries       CampaignSpendEntry[]
  paymentIntents     PaymentIntent[]
  ledgerEntries      CampaignLedgerEntry[]
  adAccount          AdAccount?              @relation(fields: [adAccountId], references: [id])
  riskAssessment     CampaignRiskAssessment?
  outcome            CampaignOutcome?

  @@index([workspaceId, status])
  @@index([adAccountId, status])
  @@index([riskAction, status])
  @@index([companyProfileId, status])
  @@index([personaId])
  @@index([provider, providerReference])
  @@index([startsAt])
  @@index([deletedAt])
}

model Destination {
  id         String          @id @default(uuid())
  campaignId String          @unique
  kind       DestinationKind
  url        String
  handle     String?
  metadata   Json            @default("{}")
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  campaign   Campaign        @relation(fields: [campaignId], references: [id])

  @@index([kind])
}

model LivePromotion {
  id                   String          @id @default(uuid())
  campaignId           String          @unique
  destinationKind      DestinationKind
  realtimeBoostEnabled Boolean         @default(false)
  expectedStartAt      DateTime
  actualStartedAt      DateTime?
  actualEndedAt        DateTime?
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt
  campaign             Campaign        @relation(fields: [campaignId], references: [id])

  @@index([destinationKind, expectedStartAt])
}

model AdAccount {
  id                 String          @id @default(uuid())
  workspaceId        String
  type               AdAccountType
  platform           AdPlatform      @default(META)
  status             AdAccountStatus @default(PENDING)
  kycTier            KycTier         @default(LIGHT)
  kycStatus          KycStatus       @default(UNVERIFIED)
  riskTier           String          @default("STANDARD")
  label              String
  walletId           String?
  connectedByUserId  String?
  externalBusinessId String?
  externalAccountId  String?
  externalPageId     String?
  dailySpendCapMinor Int?
  metadata           Json            @default("{}")
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  deletedAt          DateTime?
  workspace          Workspace       @relation(fields: [workspaceId], references: [id])
  wallet             Wallet?         @relation(fields: [walletId], references: [id])
  campaigns          Campaign[]

  @@index([workspaceId, type, status])
  @@index([platform, externalAccountId])
  @@index([deletedAt])
}

model CampaignRiskAssessment {
  id                 String             @id @default(uuid())
  campaignId         String             @unique
  score              Int                @default(0)
  action             CampaignRiskAction @default(REVIEW)
  tier               String?
  categories         String[]           @default([])
  reasons            String[]           @default([])
  autoLaunchEligible Boolean            @default(false)
  assessedByUserId   String?
  assessedAt         DateTime           @default(now())
  metadata           Json               @default("{}")
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  campaign           Campaign           @relation(fields: [campaignId], references: [id])

  @@index([action, score])
}

model CampaignOutcome {
  id               String                @id @default(uuid())
  campaignId       String                @unique
  messagesCount    Int?
  ordersCount      Int?
  estRevenueMinor  Int?
  currency         String                @default("NGN")
  rating           Int?
  wouldRunAgain    Boolean?
  source           CampaignOutcomeSource @default(CUSTOMER_PROMPT)
  capturedByUserId String?
  capturedAt       DateTime?
  notes            String?
  metadata         Json                  @default("{}")
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  campaign         Campaign              @relation(fields: [campaignId], references: [id])

  @@index([wouldRunAgain])
  @@index([source, capturedAt])
}

model Wallet {
  id                    String                      @id @default(uuid())
  workspaceId           String
  currency              String                      @default("NGN")
  status                String                      @default("ACTIVE")
  metadata              Json                        @default("{}")
  createdAt             DateTime                    @default(now())
  updatedAt             DateTime                    @updatedAt
  workspace             Workspace                   @relation(fields: [workspaceId], references: [id])
  entries               LedgerEntry[]
  vtuCharges            VtuWalletCharge[]
  virtualNumberCharges  VirtualNumberWalletCharge[]
  digitalAccessCharges  DigitalAccessWalletCharge[]
  campaignBudgetHolds   CampaignBudgetHold[]
  paymentIntents        PaymentIntent[]
  campaignLedgerEntries CampaignLedgerEntry[]
  adAccounts            AdAccount[]
  growthOrders          GrowthOrder[]

  @@unique([workspaceId, currency])
}

model LedgerEntry {
  id                    String                @id @default(uuid())
  walletId              String
  kind                  LedgerEntryKind
  amountMinor           Int
  currency              String                @default("NGN")
  reference             String
  description           String
  idempotencyKey        String?               @unique
  sourceType            String?
  sourceId              String?
  metadata              Json                  @default("{}")
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  wallet                Wallet                @relation(fields: [walletId], references: [id])
  campaignLedgerEntries CampaignLedgerEntry[]

  @@index([walletId, createdAt])
  @@index([reference])
  @@index([sourceType, sourceId])
}

model PaymentIntent {
  id                    String                @id @default(uuid())
  workspaceId           String
  gateway               String
  amountMinor           Int
  currency              String                @default("NGN")
  status                PaymentStatus         @default(PENDING)
  providerReference     String?
  walletId              String?
  campaignId            String?
  campaignInvoiceId     String?
  idempotencyKey        String?               @unique
  checkoutUrl           String?
  customerEmail         String?
  customerName          String?
  providerPayload       Json                  @default("{}")
  metadata              Json                  @default("{}")
  completedAt           DateTime?
  creditedAt            DateTime?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  workspace             Workspace             @relation(fields: [workspaceId], references: [id])
  wallet                Wallet?               @relation(fields: [walletId], references: [id])
  campaign              Campaign?             @relation(fields: [campaignId], references: [id])
  campaignInvoice       CampaignInvoice?      @relation(fields: [campaignInvoiceId], references: [id])
  campaignLedgerEntries CampaignLedgerEntry[]

  @@index([workspaceId, status])
  @@index([gateway, providerReference])
  @@index([walletId, status])
  @@index([campaignId, status])
  @@index([campaignInvoiceId, status])
}

model VoucherProduct {
  id                 String                 @id @default(uuid())
  name               String
  category           VoucherProductCategory
  handler            VoucherProductHandler
  provider           String?
  providerServiceId  String?
  inputSchema        Json                   @default("{}")
  targetWalletType   VoucherWalletType?
  active             Boolean                @default(true)
  metadata           Json                   @default("{}")
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  vouchers           Voucher[]
  rewardCampaigns    RewardCampaign[]
  rewardEntitlements RewardEntitlement[]

  @@index([category, active])
  @@index([handler, active])
}

model Voucher {
  id                    String              @id @default(uuid())
  serialNumber          String              @unique
  pinEncrypted          String
  workspaceId           String
  productId             String
  status                VoucherStatus       @default(CREATED)
  locked                Boolean             @default(false)
  ownerUserId           String?
  purchaserUserId       String
  giftNote              String?
  redemptionInput       Json                @default("{}")
  redemptionDestination String?
  metadata              Json                @default("{}")
  createdAt             DateTime            @default(now())
  activatedAt           DateTime?
  revealedAt            DateTime?
  redeemedAt            DateTime?
  expiresAt             DateTime
  updatedAt             DateTime            @updatedAt
  deletedAt             DateTime?
  workspace             Workspace           @relation(fields: [workspaceId], references: [id])
  product               VoucherProduct      @relation(fields: [productId], references: [id])
  purchaser             User                @relation("VoucherPurchaser", fields: [purchaserUserId], references: [id])
  owner                 User?               @relation("VoucherOwner", fields: [ownerUserId], references: [id])
  claimTokens           VoucherClaimToken[]

  @@index([status, expiresAt])
  @@index([purchaserUserId, createdAt])
  @@index([ownerUserId, status])
  @@index([productId, status])
}

model VoucherClaimToken {
  id                     String    @id @default(uuid())
  token                  String    @unique
  voucherId              String
  createdByShareActionAt DateTime  @default(now())
  claimedAt              DateTime?
  claimedByUserId        String?
  channel                String?
  tokenExpiresAt         DateTime
  metadata               Json      @default("{}")
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
  voucher                Voucher   @relation(fields: [voucherId], references: [id])
  claimedBy              User?     @relation("VoucherClaimedBy", fields: [claimedByUserId], references: [id])

  @@index([voucherId, tokenExpiresAt])
  @@index([claimedByUserId, claimedAt])
}

model CompanyProfile {
  id                 String                    @id @default(uuid())
  workspaceId        String
  ownerUserId        String
  name               String
  legalName          String?
  slug               String
  websiteUrl         String?
  industry           String?
  countryCode        String?
  city               String?
  timezone           String                    @default("Africa/Lagos")
  contactEmail       String?
  contactPhone       String?
  status             CompanyProfileStatus      @default(INCOMPLETE)
  verificationStatus CompanyVerificationStatus @default(UNVERIFIED)
  metadata           Json                      @default("{}")
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt
  deletedAt          DateTime?
