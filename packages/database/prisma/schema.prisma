generator client {
  provider = "prisma-client"
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum OrganizationRole {
  OWNER
  ADMIN
  MANAGER
  MARKETER
  FINANCE
  SUPPORT
  VIEWER
}

enum CampaignObjective {
  AWARENESS
  ENGAGEMENT
  TRAFFIC
  LEADS
  SALES
  APP_INSTALLS
  FOLLOWERS
  LIVE_VIEWERS
}

enum CampaignStatus {
  DRAFT
  PENDING_REVIEW
  QUEUED
  ACTIVE
  PAUSED
  COMPLETED
  REJECTED
  FAILED
}

enum DestinationKind {
  TIKTOK_PROFILE
  TIKTOK_LIVE
  TIKTOK_BOX_GAME
  TIKTOK_SHOP
  INSTAGRAM_PROFILE
  INSTAGRAM_REEL
  INSTAGRAM_LIVE
  FACEBOOK_PAGE
  FACEBOOK_LIVE
  WHATSAPP_CHANNEL
  WHATSAPP_GROUP
  TELEGRAM_CHANNEL
  TELEGRAM_GROUP
  YOUTUBE_CHANNEL
  WEBSITE
  APP
  ECOMMERCE_STORE
  FLIPTRYBE_STORE
}

enum LedgerEntryKind {
  CREDIT
  DEBIT
  HOLD
  RELEASE
  REVERSAL
}

enum PaymentStatus {
  PENDING
  REQUIRES_ACTION
  COMPLETED
  FAILED
  CANCELLED
}

enum SmmOrderStatus {
  DRAFT
  QUEUED
  PROCESSING
  COMPLETED
  PARTIAL
  FAILED
  CANCELLED
}

enum OtpProviderTier {
  PREMIUM
  BUDGET
}

enum OtpProviderStatus {
  HEALTHY
  DEGRADED
  DOWN
  DISABLED
}

enum OtpOrderStatus {
  QUOTED
  CHARGED
  ALLOCATING
  WAITING
  RECEIVED
  COMPLETED
  EXPIRED
  REFUNDED
  FAILED
  CANCELLED
}

enum OtpWalletChargeStatus {
  CHARGED
  REFUNDED
  FAILED
}

enum DigitalAccessRequestStatus {
  PENDING    @map("pending")
  PROCESSING @map("processing")
  FULFILLED  @map("fulfilled")
  CANCELLED  @map("cancelled")
  FAILED     @map("failed")
}

enum DigitalAccessWalletChargeStatus {
  CHARGED
  REFUNDED
  FAILED
}

model User {
  id                    String                 @id @default(uuid())
  email                 String                 @unique
  name                  String
  status                UserStatus             @default(ACTIVE)
  passwordHash          String?
  emailVerifiedAt       DateTime?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  deletedAt             DateTime?
  memberships           TeamMember[]
  sessions              Session[]
  auditLogs             AuditLog[]             @relation("AuditActor")
  digitalAccessRequests DigitalAccessRequest[]

  @@index([status])
  @@index([deletedAt])
}

model Organization {
  id          String       @id @default(uuid())
  name        String
  slug        String       @unique
  ownerUserId String
  region      String       @default("global")
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  deletedAt   DateTime?
  workspaces  Workspace[]
  members     TeamMember[]

  @@index([ownerUserId])
  @@index([deletedAt])
}

model Workspace {
  id                         String                      @id @default(uuid())
  organizationId             String
  name                       String
  defaultCurrency            String                      @default("NGN")
  createdAt                  DateTime                    @default(now())
  updatedAt                  DateTime                    @updatedAt
  deletedAt                  DateTime?
  organization               Organization                @relation(fields: [organizationId], references: [id])
  campaigns                  Campaign[]
  wallets                    Wallet[]
  paymentIntents             PaymentIntent[]
  smmOrders                  SmmOrder[]
  otpOrders                  OtpOrder[]
  otpWalletCharges           OtpWalletCharge[]
  digitalAccessRequests      DigitalAccessRequest[]
  digitalAccessWalletCharges DigitalAccessWalletCharge[]
  notifications              Notification[]
  supportTickets             SupportTicket[]
  referralAccounts           ReferralAccount[]
  auditLogs                  AuditLog[]

  @@index([organizationId])
  @@index([deletedAt])
}

model TeamMember {
  id             String           @id @default(uuid())
  userId         String
  organizationId String
  role           OrganizationRole
  permissions    String[]         @default([])
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  deletedAt      DateTime?
  user           User             @relation(fields: [userId], references: [id])
  organization   Organization     @relation(fields: [organizationId], references: [id])

  @@unique([userId, organizationId])
  @@index([organizationId, role])
}

model Session {
  id         String    @id @default(uuid())
  userId     String
  tokenHash  String    @unique
  deviceName String?
  ipAddress  String?
  userAgent  String?
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  user       User      @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([expiresAt])
}

model Campaign {
  id                String            @id @default(uuid())
  workspaceId       String
  creatorUserId     String
  name              String
  objective         CampaignObjective
  status            CampaignStatus    @default(DRAFT)
  budgetMinor       Int
  currency          String            @default("NGN")
  provider          String            @default("MOCK")
  providerReference String?
  startsAt          DateTime
  endsAt            DateTime?
  timezone          String            @default("UTC")
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  deletedAt         DateTime?
  workspace         Workspace         @relation(fields: [workspaceId], references: [id])
  destination       Destination?
  livePromotion     LivePromotion?
  analytics         AnalyticsMetric[]

  @@index([workspaceId, status])
  @@index([provider, providerReference])
  @@index([startsAt])
  @@index([deletedAt])
}

model Destination {
  id         String          @id @default(uuid())
  campaignId String          @unique
  kind       DestinationKind
  url        String
  handle     String?
  metadata   Json            @default("{}")
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  campaign   Campaign        @relation(fields: [campaignId], references: [id])

  @@index([kind])
}

model LivePromotion {
  id                   String          @id @default(uuid())
  campaignId           String          @unique
  destinationKind      DestinationKind
  realtimeBoostEnabled Boolean         @default(false)
  expectedStartAt      DateTime
  actualStartedAt      DateTime?
  actualEndedAt        DateTime?
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt
  campaign             Campaign        @relation(fields: [campaignId], references: [id])

  @@index([destinationKind, expectedStartAt])
}

model Wallet {
  id                   String                      @id @default(uuid())
  workspaceId          String
  currency             String                      @default("NGN")
  createdAt            DateTime                    @default(now())
  updatedAt            DateTime                    @updatedAt
  workspace            Workspace                   @relation(fields: [workspaceId], references: [id])
  entries              LedgerEntry[]
  otpCharges           OtpWalletCharge[]
  digitalAccessCharges DigitalAccessWalletCharge[]

  @@unique([workspaceId, currency])
}

model LedgerEntry {
  id             String          @id @default(uuid())
  walletId       String
  kind           LedgerEntryKind
  amountMinor    Int
  currency       String          @default("NGN")
  reference      String
  description    String
  idempotencyKey String?         @unique
  sourceType     String?
  sourceId       String?
  metadata       Json            @default("{}")
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  wallet         Wallet          @relation(fields: [walletId], references: [id])

  @@index([walletId, createdAt])
  @@index([reference])
  @@index([sourceType, sourceId])
}

model PaymentIntent {
  id                String        @id @default(uuid())
  workspaceId       String
  gateway           String
  amountMinor       Int
  currency          String        @default("NGN")
  status            PaymentStatus @default(PENDING)
  providerReference String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  workspace         Workspace     @relation(fields: [workspaceId], references: [id])

  @@index([workspaceId, status])
  @@index([gateway, providerReference])
}

model SmmOrder {
  id                String          @id @default(uuid())
  workspaceId       String
  serviceKind       String
  destinationKind   DestinationKind
  destinationUrl    String
  quantity          Int
  status            SmmOrderStatus  @default(DRAFT)
  supplierReference String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  deletedAt         DateTime?
  workspace         Workspace       @relation(fields: [workspaceId], references: [id])

  @@index([workspaceId, status])
  @@index([supplierReference])
}

model OtpService {
  id                    String          @id @default(uuid())
  code                  String
  name                  String
  countryCode           String
  providerTier          OtpProviderTier
  category              String          @default("general")
  visible               Boolean         @default(false)
  requiresAdminApproval Boolean         @default(true)
  metadata              Json            @default("{}")
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt
  deletedAt             DateTime?

  @@unique([code, countryCode, providerTier])
  @@index([countryCode, visible])
  @@index([providerTier, visible])
  @@index([deletedAt])
}

model OtpProviderConfig {
  id               String            @id @default(uuid())
  providerName     String            @unique
  tier             OtpProviderTier
  status           OtpProviderStatus @default(DISABLED)
  priority         Int               @default(100)
  markupBps        Int               @default(5500)
  enabledCountries String[]          @default([])
  enabledServices  String[]          @default([])
  metadata         Json              @default("{}")
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  deletedAt        DateTime?

  @@index([tier, status])
  @@index([deletedAt])
}

model OtpOrder {
  id                  String              @id @default(uuid())
  workspaceId         String
  serviceCode         String
  serviceName         String
  countryCode         String
  providerTier        OtpProviderTier
  providerName        String?
  providerReference   String?
  status              OtpOrderStatus      @default(QUOTED)
  phoneNumberMasked   String?
  expiresAt           DateTime?
  amountMinor         Int
  currency            String              @default("NGN")
  supplierCostMinor   Int
  supplierCurrency    String              @default("USD")
  idempotencyKey      String              @unique
  attestationAccepted Boolean             @default(false)
  riskScore           Int                 @default(0)
  requestIpAddress    String?
  requestUserAgent    String?
  requestDeviceId     String?
  metadata            Json                @default("{}")
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  deletedAt           DateTime?
  workspace           Workspace           @relation(fields: [workspaceId], references: [id])
  messages            OtpMessage[]
  walletCharges       OtpWalletCharge[]
  routingAttempts     OtpRoutingAttempt[]

  @@index([workspaceId, status, createdAt])
  @@index([providerName, providerReference])
  @@index([serviceCode, countryCode])
  @@index([deletedAt])
}

model OtpMessage {
  id                   String    @id @default(uuid())
  otpOrderId           String
  status               String    @default("RECEIVED")
  redactedMessage      String
  messageTextEncrypted String?
  receivedAt           DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  otpOrder             OtpOrder  @relation(fields: [otpOrderId], references: [id])

  @@index([otpOrderId, receivedAt])
}

model OtpProviderHealth {
  id             String            @id @default(uuid())
  providerName   String
  tier           OtpProviderTier
  status         OtpProviderStatus
  latencyMs      Int
  successRateBps Int
  balanceMinor   Int?
  currency       String?
  reason         String?
  checkedAt      DateTime          @default(now())
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([providerName, checkedAt])
  @@index([tier, status, checkedAt])
}

model OtpWalletCharge {
  id                  String                @id @default(uuid())
  workspaceId         String
  walletId            String
  otpOrderId          String
  idempotencyKey      String                @unique
  amountMinor         Int
  currency            String                @default("NGN")
  status              OtpWalletChargeStatus @default(CHARGED)
  debitLedgerEntryId  String?
  refundLedgerEntryId String?
  providerName        String?
  providerReference   String?
  metadata            Json                  @default("{}")
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  workspace           Workspace             @relation(fields: [workspaceId], references: [id])
  wallet              Wallet                @relation(fields: [walletId], references: [id])
  otpOrder            OtpOrder              @relation(fields: [otpOrderId], references: [id])

  @@unique([workspaceId, otpOrderId])
  @@index([workspaceId, status, createdAt])
  @@index([walletId, createdAt])
  @@index([providerName, providerReference])
}

model OtpRoutingAttempt {
  id           String          @id @default(uuid())
  otpOrderId   String
  providerName String
  providerTier OtpProviderTier
  score        Int
  status       String
  reason       String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  otpOrder     OtpOrder        @relation(fields: [otpOrderId], references: [id])

  @@index([otpOrderId, createdAt])
  @@index([providerName, status, createdAt])
}

model OtpPricingRule {
  id                 String          @id @default(uuid())
  tier               OtpProviderTier
  markupBps          Int
  minimumMarginMinor Int
  platformFeeMinor   Int
  customerCurrency   String          @default("NGN")
  usdToNgnRate       Int             @default(1600)
  active             Boolean         @default(true)
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  @@index([tier, active])
}

model DigitalAccessCategory {
  id          String                 @id @default(uuid())
  name        String
  slug        String                 @unique
  description String?
  sortOrder   Int                    @default(100) @map("sort_order")
  isActive    Boolean                @default(true) @map("is_active")
  createdAt   DateTime               @default(now()) @map("created_at")
  updatedAt   DateTime               @updatedAt @map("updated_at")
  deletedAt   DateTime?              @map("deleted_at")
  services    DigitalAccessService[]

  @@index([isActive, sortOrder])
  @@index([deletedAt])
  @@map("digital_access_categories")
}

model DigitalAccessService {
  id                 String                 @id @default(uuid())
  name               String
  category           String
  slug               String                 @unique
  description        String
  startingPriceMinor Int                    @default(0) @map("starting_price")
  currency           String                 @default("NGN")
  deliveryEta        String                 @map("delivery_eta")
  isActive           Boolean                @default(false) @map("is_active")
  isFeatured         Boolean                @default(false) @map("is_featured")
  thumbnail          String?
  createdAt          DateTime               @default(now()) @map("created_at")
  updatedAt          DateTime               @updatedAt @map("updated_at")
  deletedAt          DateTime?              @map("deleted_at")
  categoryRecord     DigitalAccessCategory  @relation(fields: [category], references: [slug])
  plans              DigitalAccessPlan[]
  requests           DigitalAccessRequest[]

  @@index([category, isActive])
  @@index([isFeatured, isActive])
  @@index([deletedAt])
  @@map("digital_access_services")
}

model DigitalAccessPlan {
  id          String                 @id @default(uuid())
  serviceId   String                 @map("service_id")
  planName    String                 @map("plan_name")
  duration    String
  priceMinor  Int                    @default(0) @map("price")
  currency    String                 @default("NGN")
  description String
  isActive    Boolean                @default(false) @map("is_active")
  createdAt   DateTime               @default(now()) @map("created_at")
  updatedAt   DateTime               @updatedAt @map("updated_at")
  deletedAt   DateTime?              @map("deleted_at")
  service     DigitalAccessService   @relation(fields: [serviceId], references: [id])
  requests    DigitalAccessRequest[]

  @@index([serviceId, isActive])
  @@index([deletedAt])
  @@map("digital_access_plans")
}

model DigitalAccessRequest {
  id             String                      @id @default(uuid())
  workspaceId    String                      @map("workspace_id")
  userId         String?                     @map("user_id")
  serviceId      String                      @map("service_id")
  planId         String                      @map("plan_id")
  contactType    String                      @map("contact_type")
  contactValue   String                      @map("contact_value")
  notes          String?
  status         DigitalAccessRequestStatus  @default(PENDING)
  assignedTo     String?                     @map("assigned_to")
  amountMinor    Int                         @map("amount_minor")
  currency       String                      @default("NGN")
  idempotencyKey String                      @unique @map("idempotency_key")
  metadata       Json                        @default("{}")
  createdAt      DateTime                    @default(now()) @map("created_at")
  updatedAt      DateTime                    @updatedAt @map("updated_at")
  deletedAt      DateTime?                   @map("deleted_at")
  workspace      Workspace                   @relation(fields: [workspaceId], references: [id])
  user           User?                       @relation(fields: [userId], references: [id])
  service        DigitalAccessService        @relation(fields: [serviceId], references: [id])
  plan           DigitalAccessPlan           @relation(fields: [planId], references: [id])
  walletCharges  DigitalAccessWalletCharge[]

  @@index([workspaceId, status, createdAt])
  @@index([userId, createdAt])
  @@index([serviceId, status])
  @@index([planId])
  @@index([deletedAt])
  @@map("digital_access_requests")
}

model DigitalAccessWalletCharge {
  id                  String                          @id @default(uuid())
  workspaceId         String                          @map("workspace_id")
  walletId            String                          @map("wallet_id")
  requestId           String                          @map("request_id")
  idempotencyKey      String                          @unique @map("idempotency_key")
  amountMinor         Int                             @map("amount_minor")
  currency            String                          @default("NGN")
  status              DigitalAccessWalletChargeStatus @default(CHARGED)
  debitLedgerEntryId  String?                         @map("debit_ledger_entry_id")
  refundLedgerEntryId String?                         @map("refund_ledger_entry_id")
  metadata            Json                            @default("{}")
  createdAt           DateTime                        @default(now()) @map("created_at")
  updatedAt           DateTime                        @updatedAt @map("updated_at")
  workspace           Workspace                       @relation(fields: [workspaceId], references: [id])
  wallet              Wallet                          @relation(fields: [walletId], references: [id])
  request             DigitalAccessRequest            @relation(fields: [requestId], references: [id])

  @@unique([workspaceId, requestId])
  @@index([workspaceId, status, createdAt])
  @@index([walletId, createdAt])
  @@map("digital_access_wallet_charges")
}

model AnalyticsMetric {
  id          String    @id @default(uuid())
  workspaceId String
  campaignId  String?
  name        String
  value       Float
  dimensions  Json      @default("{}")
  recordedAt  DateTime  @default(now())
  campaign    Campaign? @relation(fields: [campaignId], references: [id])

  @@index([workspaceId, name, recordedAt])
  @@index([campaignId, recordedAt])
}

model Notification {
  id          String    @id @default(uuid())
  workspaceId String
  channel     String
  title       String
  body        String
  readAt      DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  workspace   Workspace @relation(fields: [workspaceId], references: [id])

  @@index([workspaceId, readAt])
}

model SupportTicket {
  id              String    @id @default(uuid())
  workspaceId     String
  requesterUserId String
  subject         String
  status          String    @default("OPEN")
  priority        String    @default("NORMAL")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  workspace       Workspace @relation(fields: [workspaceId], references: [id])

  @@index([workspaceId, status, priority])
}

model ReferralAccount {
  id                String    @id @default(uuid())
  workspaceId       String
  code              String    @unique
  commissionRateBps Int       @default(500)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  workspace         Workspace @relation(fields: [workspaceId], references: [id])

  @@index([workspaceId])
}

model AuditLog {
  id          String     @id @default(uuid())
  workspaceId String?
  actorUserId String?
  action      String
  entityType  String
  entityId    String
  metadata    Json       @default("{}")
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  workspace   Workspace? @relation(fields: [workspaceId], references: [id])
  actor       User?      @relation("AuditActor", fields: [actorUserId], references: [id])

  @@index([workspaceId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([entityType, entityId])
}
