NODE_ENV=development
APP_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001
API_URL=http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_ENABLE_DIGITAL_ACCESS=false
NEXT_PUBLIC_ENABLE_DIGITAL_ACCESS_ADMIN=false
DATABASE_URL=postgresql://fliptrybe:fliptrybe@localhost:5432/fliptrybe_ads
# Optional. prisma.config.ts prefers this over DATABASE_URL for migrations, so a
# wrong value here breaks `prisma migrate` while leaving the app working — set it
# only if it is reachable. On Supabase, direct connections (db.<ref>.supabase.co)
# are IPv4-deprecated and time out; use the pooler on port 5432 (session mode),
# not 6543 (transaction mode), which cannot run migrations.
# DIRECT_URL=
REDIS_URL=redis://localhost:6379
JWT_SECRET=replace-with-a-long-random-secret
SESSION_SECRET=replace-with-a-long-random-secret
AUTH_SESSION_TTL_SECONDS=604800
STORAGE_PROVIDER=cloudinary
QUEUE_PRODUCER_ENABLED=true
ADS_PROVIDER=mock
PAYMENT_PROVIDER=live
PAYMENT_GATEWAY=korapay
SMM_PROVIDER=live
# Production social-service routing policy: GSUBZ primary, Sizzle Social fallback only.
# Other SMM credentials may remain documented for future provider work, but must not
# be selected for customer orders under the current production policy.
SMM_PRIMARY_PROVIDER=gsubz
SMM_FALLBACK_PROVIDER=sizzle
AI_PROVIDER=mock
NOTIFICATION_PROVIDER=mock
# Set NOTIFICATION_PROVIDER=live and populate these to send real SMS/Email/WhatsApp via Termii.
# Never commit real values here — this file documents shape only.
TERMII_API_KEY=
TERMII_BASE_URL=https://api.ng.termii.com
TERMII_SMS_SENDER_ID=FLIPTRYBE
TERMII_EMAIL_CONFIGURATION_ID=
TERMII_WHATSAPP_CONFIGURATION_ID=
ENABLE_OTP_MODULE=false
ENABLE_PREMIUM_OTP=false
ENABLE_BUDGET_OTP=false
ENABLE_OTP_ADMIN=false
ENABLE_DIGITAL_ACCESS=false
ENABLE_DIGITAL_ACCESS_ADMIN=false
TRUST_PROXY_AUTH_HEADERS=false
DIGITAL_ACCESS_TRUST_AUTH_HEADERS=false
DIGITAL_ACCESS_WORKER_ENABLED=false
DIGITAL_ACCESS_AUTOMATION_WORKER_ENABLED=false
MANAGED_ADS_WORKER_ENABLED=false
MANAGED_ADS_AUTOMATION_WORKER_ENABLED=false
# Production verification-number routing policy: 5SIM only. Other OTP supplier
# credentials may remain documented for future work, but must not be selected for
# customer number orders under the current production policy.
OTP_PROVIDER_MODE=5sim
OTP_PRIMARY_PROVIDER=5sim
OTP_FALLBACK_PROVIDER=
OTP_BETA_WORKSPACE_IDS=
OTP_USD_TO_NGN_RATE=1600
TEXTVERIFIED_API_URL=https://www.textverified.com/api/pub/v2
TEXTVERIFIED_API_KEY=
FIVESIM_API_URL=https://5sim.net/v1
FIVESIM_API_KEY=
FIVESIM_BASE_URL=https://5sim.net/v1
FIVESIM_API_TOKEN=
SMSMAN_API_URL=https://api.sms-man.com/control
SMSMAN_API_KEY=
SMSACTIVATE_API_URL=
SMSACTIVATE_API_KEY=
SMSACTIVATE_COMPATIBLE_ENABLED=false
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_PRESET=
CLOUDINARY_FOLDER=fliptrybe-ads-campaigner
CLOUDINARY_SECURE_DISTRIBUTION=
MEDIA_UPLOAD_SIGNATURE_TTL_SECONDS=900
MEDIA_UPLOAD_ALLOW_MOCK_STORAGE=false
SMDPANEL_API_URL=https://smdpanel.com/api/v2
SMDPANEL_ENDPOINT=
SMDPANEL_API_KEY=
SMDPANEL_CURRENCY=USD
SMDPANEL_SERVICE_MAP=
SMMRAJA_API_URL=https://www.smmraja.com/api/v3
SMMRAJA_API_KEY=
SMMRAJA_CURRENCY=USD
SMMRAJA_SERVICE_MAP=
JAP_API_URL=https://justanotherpanel.com/api/v2
JAP_API_KEY=
JAP_CURRENCY=USD
JAP_SERVICE_MAP=
SIZZLE_API_URL=https://app.sizzlesocial.ng/api/v1
SIZZLE_API_KEY=
SIZZLE_CURRENCY=NGN
SIZZLE_SERVICE_MAP=
PEAKERR_API_URL=https://peakerr.com/api/v2
PEAKERR_API_KEY=
PEAKERR_CURRENCY=USD
PEAKERR_SERVICE_MAP=
# GSUBZ supports both Nigeria VTU/data and social catalogues.
GSUBZ_API_KEY=
GSUBZ_BASE_URL=https://api.gsubz.com/api
# SIRP DATA: secondary/fallback supplier for Education and supported VTU/utility
# services. API token is sent as `Authentication: Token <token>`.
# Native API documentation: https://sirpdata.com/api-documentation
SIRPDATA_API_KEY=
SIRPDATA_BASE_URL=https://sirpdata.com.ng/api
CLUBKONNECT_BASE_URL=https://www.nellobytesystems.com
CLUBKONNECT_CALLBACK_URL=https://ft-campaigner-api-fra.onrender.com/webhooks/clubkonnect
CLUBKONNECT_USERNAME=
CLUBKONNECT_PASSWORD=
CLUBKONNECT_API_KEY=
CLUBKONNECT_USER_ID=CK101286023
SOGO_BASE_URL=https://api.sogo.africa
SOGO_WEBHOOK_URL=https://ft-campaigner-api-fra.onrender.com/webhooks/sogo
SOGO_PUBLIC_KEY=
SOGO_SECRET_KEY=
SOGO_API_KEY=
SOGO_SANDBOX=false
SOGO_WEBHOOK_SECRET=
RELOADLY_BASE_URL=https://giftcards.reloadly.com
RELOADLY_API_CLIENT_ID=
RELOADLY_API_CLIENT_KEY=
RELOADLY_CLIENT_ID=
RELOADLY_CLIENT_SECRET=
RELOADLY_SANDBOX=false
RELOADLY_WEBHOOK_SECRET=
KORAPAY_BASE_URL=https://api.korapay.com
KORAPAY_PUBLIC_KEY=
KORAPAY_SECRET_KEY=
KORAPAY_ENCRYPTION_KEY=
KORAPAY_WEBHOOK_URL=
KORAPAY_WEBHOOK_SECRET=
KORAPAY_REDIRECT_URL=
TREASURY_BANK_NAME=
TREASURY_ACCOUNT_NAME=
TREASURY_ACCOUNT_NUMBER=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_BASE_URL=https://api.paystack.co
PAYSTACK_REDIRECT_URL=

# Central AI Brain integration. Disabled unless enabled, URL, and key are all configured.
AI_BRAIN_ENABLED=false
AI_BRAIN_BASE_URL=http://127.0.0.1:8088
AI_BRAIN_API_KEY=
AI_BRAIN_TIMEOUT_SECONDS=0.8
PAYSTACK_SECRET_KEY=
# Financial products (virtual accounts, virtual cards, remittance) — NOT LIVE.
# ProviderConfig rows are seeded as DISABLED. See docs/providers/*.md for the
# per-provider sandbox verification status before enabling anything.
# Base URL corrected 2026-08-08: Swappr's real host is api.swappr.me/api
# (both sandbox and production — env is selected by the sk_test_/sk_live_ key
# prefix, not the URL). An earlier .env.example value here pointed at the
# wrong, non-existent host (api.swappr.ng).
SWAPPR_API_KEY=
SWAPPR_BASE_URL=https://api.swappr.me/api
SWAPPR_WEBHOOK_SECRET=
PAYSCRIBE_API_KEY=
PAYSCRIBE_BASE_URL=https://api.payscribe.ng/api/v1
PAYSCRIBE_WEBHOOK_SECRET=
# Yativo docs confirmed (docs.yativo.com, checked 2026-08-07): auth is a
# bearer token exchanged from account_id + app_secret, not a static API key —
# YATIVO_API_KEY below is used as the app_secret. YATIVO_ACCOUNT_ID is a
# separate required credential not previously modeled here.
YATIVO_API_KEY=
YATIVO_ACCOUNT_ID=
YATIVO_BASE_URL=https://api.yativo.com/api/v1
# Fincra sandbox verified 2026-08-08 (docs/providers/fincra.md) — NOT wired
# into financial-products' RemittanceProvider yet, see docs/providers/financial-routing.md.
FINCRA_API_KEY=
FINCRA_BUSINESS_ID=
FINCRA_BASE_URL=https://sandboxapi.fincra.com
FINCRA_WEBHOOK_ENCRYPTION_KEY=
# Inflow Africa — BLOCKED, supplied credential returned 401 on both sandbox
# and production hosts (docs/providers/inflow.md). No adapter implemented.
INFLOW_API_KEY=
INFLOW_BASE_URL=https://sandbox.inflowafrica.com/api
STRIPE_PUBLIC_KEY=
STRIPE_SECRET_KEY=
META_APP_ID=
META_APP_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_WEBHOOK_SECRET=
